global
  log stdout format raw local0
  maxconn 2000
  stats socket /var/run/haproxy.sock mode 660 level admin
  daemon

defaults
  mode http
  timeout connect 5s
  timeout client 30s
  timeout server 30s

resolvers consul
  nameserver consul {{ env "CONSUL_ADDR" }}
  parse-resolv-conf
  resolve_retries 3
  timeout resolve 1s
  hold valid 10s
  resolve_prefer ipv4

frontend public-http
  bind 0.0.0.0:8080
  # default backend when no k8s-tagged services match
  default_backend backend-default

  # generate ACLs & use_backend rules for every service tagged "k8s"
  {{ range $name, $tags := services }}
    {{ if has "k8s" $tags }}
      {{ $svc := service $name }}
      {{/* vhost for routing: prefer Meta.vhost, else service name */}}
      {{ $vhost := default $name $svc.Meta.vhost }}
      {{/* backend display name: prefer Meta.display_name else service name */}}
      {{ $display := default $name $svc.Meta.display_name }}
      {{/* sanitize backend identifier: replace non-alnum with '-' and lowercase */}}
      {{ $san := $display | replaceAll "[^A-Za-z0-9]+" "-" | toLower }}
      acl host_{{ $san }} hdr(host) -i {{ $vhost }}
      use_backend {{ $san }}-backend if host_{{ $san }}
    {{ end }}
  {{ end }}

backend backend-default
  mode http
  balance roundrobin
  timeout connect 1s
  timeout server 1s

{{/* Backend blocks for every k8s-tagged service */}}
{{ range $name, $tags := services }}
  {{ if has "k8s" $tags }}
    {{ $svc := service $name }}
    {{ $display := default $name $svc.Meta.display_name }}
    {{ $san := $display | replaceAll "[^A-Za-z0-9]+" "-" | toLower }}
    {{ $port := default 80 $svc.Port }}
backend {{ $san }}-backend
  mode http
  balance roundrobin
  option httpchk GET /healthz
  # create up to 5 servers from Consul DNS A records for '{{ $name }}'
  server-template {{ $san }} 5 {{ $name }}.service.consul:{{ $port }} resolvers consul init-addr none check

  {{ end }}
{{ end }}
