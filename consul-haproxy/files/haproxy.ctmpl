global
  log stdout format raw local0
  maxconn 2000
  stats socket /var/run/haproxy.sock mode 660 level admin
  #daemon

defaults
  log global
  mode http
  option httplog
  timeout connect 5s
  timeout client 30s
  timeout server 30s

resolvers consul
  nameserver consul {{ env "CONSUL_ADDR" }}
  parse-resolv-conf
  resolve_retries 3
  timeout resolve 1s
  hold valid 10s

frontend public-http
  bind 0.0.0.0:8080
  # default backend when no k8s-tagged services match
  default_backend backend-default

  # generate ACLs & use_backend rules for every service tagged "k8s"
{{- range services }}
  {{- if .Tags | contains "k8s" }}
    {{- $name := .Name }}
    {{- $instances := service .Name }}
    {{- if gt (len $instances) 0 }}
      {{- with index $instances 0 }}
        {{- $san := index .ServiceMeta "display_name" | regexReplaceAll "[^A-Za-z0-9]+" "-" | toLower }}
        {{- $vhost := index .ServiceMeta "vhost" }}
  acl host_{{ $san }} hdr(host) -i {{ $vhost }}
  use_backend {{ $san }}-backend if host_{{ $san }}
      {{ end }}
    {{- end }}
  {{- end }}
{{- end }}

backend backend-default
  mode http
  balance roundrobin
  timeout connect 1s
  timeout server 1s

{{ range services }}
# service: {{ . }}
{{- range service .Name }}
# {{ . }}
{{- end }}
{{- end }}

{{/* Backend blocks for every k8s-tagged service */}}
{{- range services }}
  {{- if .Tags | contains "k8s" }}
    {{- $name := .Name }}
    {{- $instances := service .Name }}
    {{- if gt (len $instances) 0 }}
      {{- with index $instances 0 }}
        {{- $san := index .ServiceMeta "display_name" | regexReplaceAll "[^A-Za-z0-9]+" "-" | toLower }}
        {{- $port := .Port }}

backend {{ $san }}-backend
  option httplog  
  log global
  mode http
  balance roundrobin
  option httpchk GET /
  # create up to 5 servers from Consul DNS A records for '{{ $name }}'
  server-template {{ $san }} 5 {{ $name }}.service.consul:{{ $port }} resolvers consul init-addr none check
      {{- end }}
    {{- end }}
  {{- end }}
{{ end }}

listen stats
  bind *:8404
  mode http
  stats enable
  stats uri /;csv       # csv endpoint
  stats refresh 10s
  stats auth admin:StrongPasswordHere
  stats hide-version
